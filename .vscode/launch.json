{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run starter app",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "console": "integratedTerminal"
    }
  ]
}
